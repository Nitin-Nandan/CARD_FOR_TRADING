# ============================================
# 1. THE "BIG DATA" BLOCK (CRITICAL)
# ============================================
data/raw/
data/processed/
data/windows/
data/market_indices/
checkpoints/
wandb/

# Block all heavy ML binaries globally
*.parquet
*.npy
*.npz
*.pt
*.bin
*.h5

# Keep the directory structure only
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/windows/.gitkeep
!checkpoints/.gitkeep
!data/configs/
!data/sample/

# ============================================
# 2. GENERATED REPORTS & REFERENCE BINARIES
# ============================================
# Auto-generated checkpoint metadata dump
ckpt_info.txt

# Reference PDFs (large binaries, not code)
docs/reference/*.pdf

# ============================================
# 3. LOGS & MONITORING
# ============================================
logs/
*.log
fyersApi.log
fyersRequests.log
.ipynb_checkpoints/

# Keep only the directory and reports
!logs/.gitkeep
!logs/reports/.gitkeep

# ============================================
# 4. PYTHON & WINDOWS
# ============================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
*.env

# Windows
[Dd]esktop.ini
Thumbs.db
$RECYCLE.BIN/

# ============================================
# 5. AI AGENT INFRASTRUCTURE
# ============================================
# .agents/ is NOT ignored — rules, skills, and commands
# form part of the project's governance layer.

# ============================================
# 6. VENDOR & EXTERNAL
# ============================================
# Ignore vendor contents but keep the directory structure
vendor/pandas_ta/*
!vendor/pandas_ta/.gitkeep
!vendor/pandas_ta/setup.py

# Ignore build artifacts
vendor/pandas_ta/*.egg-info/
vendor/pandas_ta/build/
vendor/pandas_ta/dist/
vendor/pandas_ta/__pycache__/